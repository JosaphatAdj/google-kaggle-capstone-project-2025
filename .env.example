# ============================================================
# ROBONEST SYSTEM - ENVIRONMENT VARIABLES
# ============================================================

# ============================================================
# GOOGLE GEMINI API
# ============================================================

GOOGLE_API_KEY=your_api_key_here

# ============================================================
# JIRA CONFIGURATION
# ============================================================
# Get API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SERVER=https://your-jira-server.atlassian.net
JIRA_EMAIL=your-email@gmail.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=your-project-key

# ============================================================
# GMAIL CONFIGURATION
# ============================================================
# IMPORTANT: Use App Password, not regular password!
# Create App Password: https://support.google.com/accounts/answer/185833
GMAIL_SMTP_SERVER=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SENDER_EMAIL=your_email@gmail.com #for human escalation
GMAIL_SENDER_PASSWORD=your_app_password
# Division email mapping
 DIVISION_EMAILS = {
    "support": "support@robonest.com", #put your mail to receive escalation from support agents
}

# Division Emails (recipients)
# These are automatically used by Gmail Tool
# support@robonest.com - Support division  
# marketing@robonest.com - Marketing division
# hr@robonest.com - HR division
# ops@robonest.com - Operations/COO

# ============================================================
# SERVER CONFIGURATION
# ============================================================
ALERT_RECEIVER_PORT=8000
ROBOT_PORT=8001

# ============================================================
# SECURITY
# ============================================================
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=24

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================
# NOTES
# ============================================================
# 1. Never commit this file with real credentials!
# 2. Copy this to .env and fill in your values
# 3. Make sure .env is in .gitignore