# Google Gemini API Key (Required)
GOOGLE_API_KEY=your_api_key_here

# Optional: Service Ports
ALERT_RECEIVER_PORT=8000
ROBOT_PORT=8001

# Optional: Logging
LOG_LEVEL=INFO

# Optional: Gmail Notifications (For Production)
GMAIL_ENABLED=false
GMAIL_USER=support@robonest.com
GMAIL_APP_PASSWORD=

# Optional: Jira Integration (For Production)
JIRA_ENABLED=false
JIRA_URL=https://jira.robonest.com
JIRA_API_TOKEN=
JIRA_PROJECT=ROBOT
